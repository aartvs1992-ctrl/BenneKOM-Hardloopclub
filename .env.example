# Kopieer naar .env.local (lokaal) of vul in bij Vercel → Settings → Environment Variables.
# Zonder Supabase draait de app met tijdelijke voorbeelddata (handig om te testen).

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Wachtwoord voor de beheerpagina (/beheer)
ADMIN_PASSWORD=

# Pushmeldingen: maak sleutels aan met `npm run vapid`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@hardloopclubbennekom.nl

# Beveiligt de automatische dinsdagherinnering (Vercel vult dit zelf in bij cron jobs)
CRON_SECRET=

# Strava (persoonlijke 5km Challenge) → strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_SEGMENT_ID=23298531
